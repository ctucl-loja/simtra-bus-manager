# SIMTRA Bus Manager — copiar como .env en la raíz del proyecto (cp .env.example .env).
# Un solo archivo sirve para main.py, services/bus_monitor.py y services/data_loader.py
# (python-dotenv lo busca hacia arriba desde services/).
# Requisito del sistema (no es variable): zona horaria America/Guayaquil
#   sudo timedatectl set-timezone America/Guayaquil

# ── Identidad del bus (OBLIGATORIA, entero > 0) ──────────────────────────────
# Debe ser el bus asignado a ESTE equipo en Buslytics; si no, device-api responde 403.
FAST_API_BUS_REGISTER=

# ── Backend remoto Buslytics / device-api ────────────────────────────────────
# URL base SIN /api (el cliente añade /api/device-api/...). Sin barra final.
#   Producción: https://<host-de-buslytics>
#   Desarrollo: http://localhost:4000   (PORT por defecto del backend)
FAST_API_BACKEND_URL=https://api.simtra.example.com

# OBLIGATORIA. Clave del equipo (panel de Buslytics → Dispositivos). Se envía en la
# cabecera X-API-Key; nunca en la URL ni en logs. Vacía = error explícito, nada se sube.
# FAST_API_BACKEND_USERNAME y FAST_API_BACKEND_PASSWORD están RETIRADAS: eliminarlas.
FAST_API_DEVICE_API_KEY=

# ── API local (FastAPI en esta RPi) ──────────────────────────────────────────
# Opcional (def. http://127.0.0.1:8000). El puerto debe coincidir con el --port de uvicorn.
FAST_API_LOCAL_BACKEND=http://127.0.0.1:8000

# Opcional (def. "*"). Orígenes CORS de bus-display, separados por comas. Si se
# restringe, incluir también http://<IP_LAN_RPI>:4173 para abrirla desde otra máquina.
FAST_API_CORS_ORIGINS=*

# ── Intervalos del monitor (segundos, enteros > 0; inválido → valor por defecto) ──
FAST_API_POLL_INTERVAL_SECONDS=2
FAST_API_WATCHER_INTERVAL_SECONDS=10

# ── Energía (opcional; los valores por defecto sirven en Raspberry Pi OS) ────
# Requieren sudo NOPASSWD limitado a estos comandos exactos (ver README, «Permisos mínimos»).
#SYSTEM_SHUTDOWN_COMMAND=sudo -n /sbin/shutdown -h now
#SYSTEM_REBOOT_COMMAND=sudo -n /sbin/shutdown -r now