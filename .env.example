# ─────────────────────────────────────────────
# SIMTRA Bus Manager — variables de entorno
#
# Copiar como .env en la RAIZ del proyecto (/home/admin/simtra-bus-manager/).
# Un solo archivo sirve para los tres servicios: python-dotenv lo busca hacia
# arriba desde el archivo que llama a load_dotenv(), asi que services/ tambien
# lo encuentra aunque systemd los arranque con WorkingDirectory=.../services/.
#
#   cp .env.example .env
# ─────────────────────────────────────────────


# ── Identidad del bus ────────────────────────────────────────────────────────
# Numero de registro de la unidad. Determina que despachos y que vehiculo se
# consultan en el backend remoto. Usado por bus_monitor.py y data_loader.py.
FAST_API_BUS_REGISTER=1624


# ── Backend remoto SIMTRA ────────────────────────────────────────────────────
# Unica salida a internet del sistema: solo bus_monitor.py y data_loader.py
# hablan con el, autenticandose por JWT (services/api.py). La pantalla del bus
# (bus-display) NUNCA lo consulta directamente.
FAST_API_BACKEND_URL=https://api.simtra.example.com
FAST_API_BACKEND_USERNAME=usuario@simtra.example.com
FAST_API_BACKEND_PASSWORD=cambiame


# ── API local (FastAPI en esta misma Raspberry Pi) ───────────────────────────
# URL con la que los servicios se comunican con main.py. Se deja en 127.0.0.1
# porque todo corre en el mismo dispositivo; el puerto debe coincidir con el
# --port del ExecStart de simtra-bus-manager.service.
FAST_API_LOCAL_BACKEND=http://127.0.0.1:8000

# Origenes permitidos por CORS para la pantalla del bus (bus-display), que es
# cross-origin al correr en otro puerto. Lista separada por comas; "*" abre a
# cualquier origen, aceptable porque el equipo esta aislado dentro del bus.
#
# Con "*" tambien funciona abrir la pantalla desde una laptop de la misma LAN
# (http://<IP_LAN_DE_LA_RPI>:4173). Si se restringe la lista hay que incluir ESE
# origen ademas del local, porque el navegador de la laptop no envia
# http://localhost:4173 sino la IP de la RPi:
#   http://localhost:4173,http://192.168.1.14:4173
#
# Aplica igual a GET /api/system/network, que consume la vista /info de la
# pantalla. Como la API local no usa cookies ni auth, allow_credentials queda en
# False en main.py y no debe habilitarse.
FAST_API_CORS_ORIGINS=*


# ── Intervalos del monitor (segundos) ────────────────────────────────────────
# Si faltan o no son numeros positivos, bus_monitor.py usa el valor por defecto
# y lo avisa en el log ([CONFIG]) en vez de no arrancar: en un bus es preferible
# monitorear con el intervalo por defecto a quedarse sin geofencing.
#
# Cada cuanto lee la ultima posicion GPS para evaluar las geocercas (def. 2).
FAST_API_POLL_INTERVAL_SECONDS=2
# Cada cuanto el watcher revisa si cambio el turno o si es un dia nuevo (def. 10).
FAST_API_WATCHER_INTERVAL_SECONDS=10
